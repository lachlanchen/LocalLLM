# LocalLLM services bind to loopback by default. Change deliberately for LAN use.
LOCALLLM_HOST=127.0.0.1
LOCALLLM_PORT=8008
LOCALLLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCALLLM_API_KEY=local-dev-key
LOCALLLM_DATA_DIR=./data
LOCALLLM_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8008"]'
LOCALLLM_ALLOWED_HOSTS='["127.0.0.1","localhost","[::1]"]'

# Optional search providers. Deep Research works without these through DDGS.
LOCALLLM_BRAVE_SEARCH_API_KEY=
LOCALLLM_TAVILY_API_KEY=

# Reverse-engineering tools installed by scripts/setup-re-toolchain.sh.
LOCALLLM_GHIDRA_HOME=./.local/opt/ghidra_12.0.3_PUBLIC
LOCALLLM_OGHIDRA_HOME=./.local/tools/OGhidra
LOCALLLM_PYGHIDRA_MCP_URL=http://127.0.0.1:18765/mcp
