# LocalLLM Studio is intentionally loopback-only. The management API is not
# authenticated; do not proxy or tunnel port 8008 until authorization is added.
LOCALLLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# These GPU settings are read and rendered into the user unit by
# scripts/install-user-services.sh. Rerun that installer after changing them.
# Set the expected count to 2 on a fixed dual-GPU workstation. Keep 0 for
# CPU-only or variable-GPU installations.
LOCALLLM_EXPECTED_GPU_COUNT=0
LOCALLLM_GPU_READY_ATTEMPTS=120
LOCALLLM_GPU_READY_INTERVAL_SECONDS=1
# Bound Ollama's default for direct `/v1` requests. The grounded app routes
# choose a model-aware context at or below this practical dual-4090 ceiling.
LOCALLLM_OLLAMA_CONTEXT_LENGTH=65536
# 0 lets Ollama place fitting models on one GPU. Set 1 to intentionally spread
# every model across all GPUs; rerun scripts/install-user-services.sh afterward.
LOCALLLM_OLLAMA_SCHED_SPREAD=0
LOCALLLM_API_KEY=local-dev-key
LOCALLLM_DATA_DIR=./data
LOCALLLM_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8008","http://localhost:8008"]'
LOCALLLM_ALLOWED_HOSTS='["127.0.0.1","localhost"]'

# Federated web and academic search. Crossref, Semantic Scholar (at public
# limits), Europe PMC, and arXiv work without keys. Keyless web fallback uses
# structured Wikipedia, GitHub repository, and Hacker News APIs plus explicit
# DDGS engines for DuckDuckGo, Brave, Yahoo, and Mojeek. Add one or more web API
# keys for more dependable coverage.
LOCALLLM_SEARCH_BRAVE_API_KEY=
LOCALLLM_SEARCH_TAVILY_API_KEY=
LOCALLLM_SEARCH_SERPER_API_KEY=
# Optional Crossref polite-pool mailto contact; it is not sent to other providers.
LOCALLLM_SEARCH_CROSSREF_EMAIL=
# Optional; improves Semantic Scholar rate limits.
LOCALLLM_SEARCH_SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex currently requires an API key and remains disabled without one.
LOCALLLM_SEARCH_OPENALEX_API_KEY=
# Optional Google Scholar result source through third-party SerpAPI. LocalLLM
# has no direct Scholar API integration and never scrapes Scholar HTML.
LOCALLLM_SEARCH_SERPAPI_API_KEY=
LOCALLLM_SEARCH_MAX_RESULTS=30
LOCALLLM_SEARCH_MAX_CONCURRENCY=4
LOCALLLM_SEARCH_PROVIDER_TIMEOUT_SECONDS=12
LOCALLLM_SEARCH_RESPONSE_LIMIT_BYTES=2000000

# Reverse-engineering tools installed by scripts/setup-re-toolchain.sh.
LOCALLLM_GHIDRA_HOME=./.local/opt/ghidra_12.0.3_PUBLIC
LOCALLLM_OGHIDRA_HOME=./.local/tools/OGhidra
LOCALLLM_PYGHIDRA_MCP_URL=http://127.0.0.1:18765/mcp
