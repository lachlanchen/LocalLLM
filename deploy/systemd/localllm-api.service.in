[Unit]
Description=LocalLLM Studio API and web application
After=localllm-ollama.service
Wants=localllm-ollama.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=-@PROJECT_ROOT@/.env
ExecStart=@PROJECT_ROOT@/apps/api/.venv/bin/uvicorn localllm.main:app --app-dir @PROJECT_ROOT@/apps/api --host 127.0.0.1 --port 8008
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

