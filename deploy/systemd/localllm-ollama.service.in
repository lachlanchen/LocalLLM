[Unit]
Description=LocalLLM project-local Ollama server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=@PROJECT_ROOT@/.local/models/ollama
Environment=OLLAMA_KEEP_ALIVE=15m
Environment=OLLAMA_CONTEXT_LENGTH=@OLLAMA_CONTEXT_LENGTH@
Environment=OLLAMA_SCHED_SPREAD=@OLLAMA_SCHED_SPREAD@
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_MAX_LOADED_MODELS=2
Environment=OLLAMA_MAX_QUEUE=32
Environment=OLLAMA_NUM_PARALLEL=1
Environment=LOCALLLM_EXPECTED_GPU_COUNT=@EXPECTED_GPU_COUNT@
Environment=LOCALLLM_GPU_READY_ATTEMPTS=@GPU_READY_ATTEMPTS@
Environment=LOCALLLM_GPU_READY_INTERVAL_SECONDS=@GPU_READY_INTERVAL_SECONDS@
TimeoutStartSec=@GPU_START_TIMEOUT_SECONDS@
ExecStartPre=@PROJECT_ROOT@/scripts/wait-for-gpus.sh
ExecStart=@PROJECT_ROOT@/.local/ollama/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
